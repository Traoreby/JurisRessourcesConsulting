# Variables Supabase publiques (accessibles côté client et serveur)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Variables Supabase privées (accessibles uniquement côté serveur)
# Ne jamais exposer ces clés dans le frontend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
